# # Enable or disable mock data
# # Set to "true" to use mock data, "false" to use only API data
# NEXT_PUBLIC_USE_MOCK_DATA=false

# # API Base URLs
# NEXT_PUBLIC_LOCAL_BASE_URL=https://jenideals.com/jeniNewVersion/api/android/version5
# NEXT_PUBLIC_CLOUD_BASE_URL=https://jenideals.com/jeniNewVersion/api/android/version5
# NEXT_PUBLIC_PROXY_BASE_URL=/api/v5

# # Holidays API & URLs
# NEXT_PUBLIC_HOLIDAYS_API_BASE_URL=https://jenideals.com/jeniNewVersion/holidays/api
# NEXT_PUBLIC_HOLIDAYS_URL=https://jenideals.com/jeniNewVersion/holidays

# # API Base URL: set to "local" or "cloud"
# NEXT_PUBLIC_API_BASE=cloud


# Enable or disable mock data
# Set to "true" to use mock data, "false" to use only API data
NEXT_PUBLIC_USE_MOCK_DATA=false

# API Base URLs
NEXT_PUBLIC_LOCAL_BASE_URL=https://admin.jenideals.com/api/android/version6
NEXT_PUBLIC_CLOUD_BASE_URL=https://admin.jenideals.com/api/android/version6
NEXT_PUBLIC_PROXY_BASE_URL=https://admin.jenideals.com/api/android/version6

# Holidays API & URLs
NEXT_PUBLIC_HOLIDAYS_API_BASE_URL=https://admin.jenideals.com/holidays/api
NEXT_PUBLIC_HOLIDAYS_URL=https://holidays.jenideals.com/holidays

# API Base URL: set to "local" or "cloud"
NEXT_PUBLIC_API_BASE=cloud

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=y25638ax6l
